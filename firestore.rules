rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function getUser() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data;
    }
    // Lo staff entrato con PIN non ha un profilo in /utenti: senza questo
    // controllo getUser() andrebbe in errore invece di restituire false.
    function haProfilo() {
      return isAuth() && exists(/databases/$(database)/documents/utenti/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return haProfilo() && getUser().role == 'superadmin';
    }
    function isManagerOf(restaurantId) {
      return haProfilo()
        && getUser().role == 'manager'
        && getUser().restaurantId == restaurantId;
    }
    function isOperatoreOf(restaurantId) {
      return haProfilo()
        && getUser().restaurantId == restaurantId
        && getUser().role in ['cucina','pizzeria','bar','pasticceria','antipasti','cassa'];
    }
    function isMemberOf(restaurantId) {
      return isManagerOf(restaurantId) || isOperatoreOf(restaurantId);
    }
    // Staff entrato con PIN da /accesso/[reparto]: custom token emesso da
    // /api/accesso-rapido con i claims accessoRapido, restaurantId e role.
    function isStaffRapidoOf(restaurantId) {
      return isAuth()
        && request.auth.token.get('accessoRapido', false) == true
        && request.auth.token.get('restaurantId', '') == restaurantId
        && request.auth.token.get('role', '') in ['cucina','pizzeria','bar','pasticceria','antipasti','cassa'];
    }
    function isStaffOf(restaurantId) {
      return isOperatoreOf(restaurantId) || isStaffRapidoOf(restaurantId);
    }

    // ── Utenti globali ───────────────────────────────────────────────────
    match /utenti/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ── Ristoranti ───────────────────────────────────────────────────────
    // Il documento contiene solo dati da vetrina: get pubblico (dashboard
    // reparti, accesso rapido), ma nessun list pubblico. Il menu cliente
    // cerca lo slug lato server. La fatturazione sta in config/billing.
    match /ristoranti/{restaurantId} {
      function senzaCampiBilling() {
        return !request.resource.data.keys().hasAny(['piano', 'statoAbbonamento', 'stripeCustomerId', 'stripeSubscriptionId']);
      }
      // Il manager modifica solo grafica e anagrafica: slug, attivo e
      // fatturazione restano a superadmin e server (Admin SDK).
      function aggiornamentoManagerValido() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'colori', 'font', 'logo', 'indirizzo', 'telefono', 'onboardingCompletato', 'updatedAt'
        ]);
      }

      allow get:    if true;
      allow list:   if isSuperAdmin();
      allow create: if isSuperAdmin() && senzaCampiBilling();
      allow update: if senzaCampiBilling()
        && (isSuperAdmin() || (isManagerOf(restaurantId) && aggiornamentoManagerValido()));
      allow delete: if isSuperAdmin();

      // ── Menu: categorie ───────────────────────────────────────────────
      match /categorie/{docId} {
        allow read:  if true; // clienti possono leggere il menu
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Menu: piatti ──────────────────────────────────────────────────
      match /piatti/{docId} {
        allow read:  if true; // clienti possono leggere il menu
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Tavoli ────────────────────────────────────────────────────────
      // Il cliente legge il tavolo dal QR; lo stato "occupato" lo scrive
      // /api/ordini (Admin SDK). Lo staff può cambiare solo lo stato.
      match /tavoli/{docId} {
        allow read:   if true;
        allow update: if isSuperAdmin() || isManagerOf(restaurantId)
          || (isStaffOf(restaurantId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato'])
              && request.resource.data.stato in ['libero', 'occupato', 'pagamento']);
        allow create, delete: if isSuperAdmin() || isMemberOf(restaurantId);
      }

      // ── Ordini ────────────────────────────────────────────────────────
      // Creazione e annullamento del cliente passano da /api/ordini (Admin SDK),
      // i pagamenti dai webhook/cattura server-side. Il cliente può solo
      // leggere il proprio ordine per ID (auto-ID non indovinabile): nessun
      // list pubblico. Lo staff aggiorna righe/stato ma non può toccare
      // totale e metodo, né far uscire un ordine da "in_attesa_pagamento".
      match /ordini/{docId} {
        function aggiornamentoStaffValido() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['righe', 'stato', 'updatedAt'])
            && resource.data.stato != 'in_attesa_pagamento'
            && request.resource.data.stato in ['ricevuto', 'in_preparazione', 'pronto', 'servito']
            && request.resource.data.righe.size() == resource.data.righe.size();
        }

        allow get:    if true;
        allow list:   if isSuperAdmin() || isManagerOf(restaurantId) || isStaffOf(restaurantId);
        allow create: if false;
        allow update: if isSuperAdmin() || isManagerOf(restaurantId)
          || (isStaffOf(restaurantId) && aggiornamentoStaffValido());
        allow delete: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Utenti del ristorante ─────────────────────────────────────────
      match /utenti/{docId} {
        allow read:  if isSuperAdmin() || isManagerOf(restaurantId);
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Config (accesso rapido, pagamenti, billing) ────────────────────
      // "pagamenti" contiene solo flag pubblici (quali metodi sono attivi) —
      // il menu cliente lo legge senza auth.
      // "pagamenti-secret" (chiavi Stripe/PayPal) non è accessibile dal client:
      // si legge mascherato e si scrive solo tramite /api/pagamenti/segreti.
      // "accesso-rapido" contiene solo l'hash del PIN e lo scrive solo il server
      // (/api/accesso-rapido/config), così non può tornare in chiaro.
      // "billing" (piano, abbonamento, ID Stripe) lo scrive solo il server.
      match /config/{docId} {
        allow read:  if docId == 'pagamenti'
          || (docId != 'pagamenti-secret' && (isSuperAdmin() || isManagerOf(restaurantId)));
        allow write: if !(docId in ['billing', 'accesso-rapido', 'pagamenti-secret'])
          && (isSuperAdmin() || isManagerOf(restaurantId));
      }
    }
  }
}
