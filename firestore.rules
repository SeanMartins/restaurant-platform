rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function getUser() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return isAuth() && getUser().role == 'superadmin';
    }
    function isManagerOf(restaurantId) {
      return isAuth()
        && getUser().role == 'manager'
        && getUser().restaurantId == restaurantId;
    }
    function isOperatoreOf(restaurantId) {
      return isAuth()
        && getUser().restaurantId == restaurantId
        && getUser().role in ['cucina','pizzeria','bar','pasticceria','antipasti','cassa'];
    }
    function isMemberOf(restaurantId) {
      return isManagerOf(restaurantId) || isOperatoreOf(restaurantId);
    }

    // ── Utenti globali ───────────────────────────────────────────────────
    match /utenti/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ── Ristoranti ───────────────────────────────────────────────────────
    // NB: read pubblico perché menu cliente e accesso-rapido reparti/cassa
    // leggono da client senza Firebase Auth (PIN gestito via API server-side).
    match /ristoranti/{restaurantId} {
      allow read:   if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isManagerOf(restaurantId);
      allow delete: if isSuperAdmin();

      // ── Menu: categorie ───────────────────────────────────────────────
      match /categorie/{docId} {
        allow read:  if true; // clienti possono leggere il menu
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Menu: piatti ──────────────────────────────────────────────────
      match /piatti/{docId} {
        allow read:  if true; // clienti possono leggere il menu
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Tavoli ────────────────────────────────────────────────────────
      match /tavoli/{docId} {
        allow read:   if true; // clienti devono leggere info tavolo via QR
        allow update: if true; // l'ordine cliente aggiorna lo stato tavolo senza auth
        allow create, delete: if isSuperAdmin() || isMemberOf(restaurantId);
      }

      // ── Ordini ────────────────────────────────────────────────────────
      // read/update pubblici: il cliente segue lo stato del proprio ordine e
      // i reparti/cassa in accesso-rapido (PIN) non hanno Firebase Auth.
      match /ordini/{docId} {
        allow read:   if true;
        allow create: if true;
        allow update: if true;
        allow delete: if isSuperAdmin() || isManagerOf(restaurantId) || resource.data.stato == 'ricevuto';
      }

      // ── Utenti del ristorante ─────────────────────────────────────────
      match /utenti/{docId} {
        allow read:  if isSuperAdmin() || isManagerOf(restaurantId);
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }

      // ── Config (accesso rapido, pagamenti) ─────────────────────────────
      // "pagamenti" contiene solo flag pubblici (quali metodi sono attivi) —
      // il menu cliente lo legge senza auth. Le chiavi segrete vivono in
      // "pagamenti-secret", leggibile solo dal manager (mai dal cliente).
      // L'accesso-rapido dello staff passa dall'API server-side, non da qui.
      match /config/{docId} {
        allow read:  if docId == 'pagamenti' || isSuperAdmin() || isManagerOf(restaurantId);
        allow write: if isSuperAdmin() || isManagerOf(restaurantId);
      }
    }
  }
}
